FROM python:3.11-slim

WORKDIR /app

# 使用国内 apt 镜像源（避免 Docker 构建时网络不通）
# Debian Trixie 使用 DEB822 格式 (.sources)，同时兼容旧格式 (.list)
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com

# PostgreSQL async/sync drivers
RUN pip install --no-cache-dir asyncpg psycopg2-binary aiosqlite sse-starlette -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com

# Application code
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini .
COPY backend/scripts ./scripts

RUN mkdir -p /app/data /app/logs /app/logs/engines

ARG BUILD_TIME=""
ENV WORKERS=4
ENV BUILD_TIME=${BUILD_TIME}
EXPOSE 8200

CMD uvicorn app.main:app --host 0.0.0.0 --port 8200 --workers $WORKERS
