# LLM Platform Configuration
# Copy to backend/.env and update values

# Security — MUST change in production
JWT_SECRET=your-secret-key-here

# Database
# 注：dev 用 docker-compose.dev.yml 起 postgres 时映射到 5433（避开宿主机 5432）
DATABASE_URL=postgresql+asyncpg://llmuser:llmpass123@localhost:5433/llm_platform
DATABASE_SYNC_URL=postgresql+psycopg2://llmuser:llmpass123@localhost:5433/llm_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Debug mode (enables auto-create tables, Swagger UI)
DEBUG=true

# vLLM defaults
VLLM_REQUEST_TIMEOUT=120
VLLM_MAX_TOKENS=4096

# Model download directory
MODEL_DOWNLOAD_DIR=./llm_models
